df_main = output$df_main
df_returns = output$df_my_funds_returns
df_returns$portfolio_ISA<-NULL
output$df_main_mini
# probabilistic Sharp
melt((PerformanceAnalytics::ProbSharpeRatio(df_returns, Rf = 0, refSR = rep(0, ncol(df_returns)))$sr_prob)) %>%
arrange(desc(value))
clusters_list = list()
first_date = as.character(max(df_main$first_trading_date))
for (dat in c("2019-05-01", "2020-11-01",first_date )){
df_tscluster = na.omit(df_main %>% group_by(fund) %>% unnest(close_prices) %>%
#dplyr::filter(Date >= as.Date(Sys.Date()) %m-% months(2)) %>%
dplyr::filter(Date >= dat) %>%
subset(select = c(fund, Date, Close)))
df_list <- as.list(utils::unstack(df_tscluster, Close ~ fund))
df_list = dtwclust::zscore(df_list)
vi_evaluators <- cvi_evaluators("VI", ground.truth = names(df_list))
score_fun <- vi_evaluators$score
pick_fun <- vi_evaluators$pick
# compare different configurations
comparison_long <-
compare_clusterings(
df_list,
types = c("p", "h", "f", "t"),
configs = cfgs,
seed = 293L,
trace = TRUE,
score.clus = score_fun,
pick.clus = pick_fun,
return.objects = TRUE
)
df_best_clusters = data.frame(fund = names(df_list), cluster =comparison_long$pick$object@cluster)
df_best_clusters = full_join(df_best_clusters, df_main[c("fund", "ISIN")], by = "fund")
temp = df_best_clusters[order(df_best_clusters$cluster), ]
colnames(temp)[2]<-paste0("cluster_",dat)
clusters_list[[dat]] = temp
}
clusters_list = clusters_list %>% reduce(left_join, by = c("fund","ISIN"))
clusters_list$Change_group = T
clusters_list$Change_group[clusters_list$`cluster_2019-05-01` == clusters_list$`cluster_2020-11-01` ]<-F
# momentum clustering clustering
df_tscluster = na.omit(df_main %>% group_by(fund) %>% unnest(close_prices) %>%
#dplyr::filter(Date >= as.Date(Sys.Date()) %m-% months(2)) %>%
dplyr::filter(Date >= first_date) %>%
subset(select = c(fund, Date, Close)))
df_list <- as.list(utils::unstack(df_tscluster, Close ~ fund))
df_list = dtwclust::zscore(df_list)
vi_evaluators <- cvi_evaluators("VI", ground.truth = names(df_list))
score_fun <- vi_evaluators$score
pick_fun <- vi_evaluators$pick
# compare different configurations
comparison_long <-
compare_clusterings(
df_list,
types = c("p", "h", "f", "t"),
configs = cfgs,
seed = 293L,
trace = TRUE,
score.clus = score_fun,
pick.clus = pick_fun,
return.objects = TRUE
)
# best results
plot(comparison_long$pick$object)
print(comparison_long$pick$config)
# clean results - momentum funds
df_best_clusters = data.frame(fund = names(df_list), cluster =comparison_long$pick$object@cluster)
df_best_clusters = full_join(df_best_clusters, df_main[c("fund", "ISIN")], by = "fund")
df_best_clusters = df_best_clusters[order(df_best_clusters$cluster), ]
plot(comparison_long$pick$object, type = "sc")
