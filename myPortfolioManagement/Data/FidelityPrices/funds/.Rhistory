input_path = "/Users/safishajjouz/myFinances/input_files"
file_path = file.path(input_path,"myfunds_prices.xlsx")
df_all <-readxl::read_excel(file_path, guess_max = 10000)
df_all$Date <- as.Date(df_all$Date)
df_japan = df_all %>% dplyr::filter(fund == "Baillie Gifford Japanese B Acc")
df_japan$Close[df_japan$Date >= "2020-09-01"]= df_japan$Close[df_japan$Date >= "2020-09-01"]*100
#df_MI = df_all %>% dplyr::filter(fund == "MI Chelverton UK Equity Growth Fund B Acc")
#df_MI$Close[df_MI$Date <= "2021-04-13"]= df_MI$Close[df_MI$Date <= "2021-04-13"]/100
#df_all = df_all %>% dplyr::filter(! fund %in% c("Baillie Gifford Japanese B Acc","MI Chelverton UK Equity Growth Fund B Acc" ) )
df_all = df_all %>% dplyr::filter(! fund %in% c("Baillie Gifford Japanese B Acc") )
df_all = rbind(df_all, df_japan)
#df_all = rbind(df_all, df_MI)
#df_all$date_of_purchase <-as.Date(df_all$date_of_purchase, format = "%d/%m/%Y")
#df_all$date_of_purchase[which(df_all$ISIN == "IE0032077012") ] = min(df_all$date_of_purchase, na.rm = TRUE)
# instrumental input to correct names
#df_names <-readxl::read_excel(file.path(input_path,"myfunds.xlsx"), guess_max = 10000)
#df_names = df_names[, c("ISIN", "fund")]
#df_all$fund<-NULL
#df_all = left_join(df_all, df_names)
df = df_all
# work with main dataframe
temp = df %>% subset(select = c(fund, Date, Close)) %>%
group_by(fund) %>%
nest(.key = 'close_prices')
names(temp$close_prices) <- temp$fund
df = df %>% group_by(ISIN) %>%
mutate(
trading_weeks = n_distinct(Date),
latest_trading_date = max(Date),
first_trading_date = min(Date)
) %>% subset( select = -c(Date, Close) ) %>%
unique() %>%
full_join(temp)
# add sample returns
if (is.null(lookback)==F) {
df_returns = df %>%
unnest(cols = close_prices) %>%
dplyr::filter(Date >= lubridate::ymd(Sys.Date()) -
lubridate::years(lookback)) %>%
subset( select = c(fund,Date,Close)) %>%
group_by(fund) %>%
tq_transmute(
select     = Close,
mutate_fun = periodReturn,
period     = period_returns,
type = type_returns,
col_rename = "Ra"
) %>%
nest(.key = 'sample_returns')
} else{
df_returns =  df %>%
unnest(cols = close_prices) %>%
subset( select = c(fund,Date,Close)) %>%
group_by(fund) %>%
tq_transmute(
select     = Close,
mutate_fun = periodReturn,
period     = period_returns,
type = type_returns,
col_rename = "Ra"
) %>%
nest(.key = 'sample_returns')
}
names(df_returns$sample_returns) <- df_returns$fund
df = full_join(df, df_returns)
df_returns = df %>% subset( select = c(fund,sample_returns)) %>%
unnest(cols = sample_returns) %>%
spread( key = fund, value = Ra)
